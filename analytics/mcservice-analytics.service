[Unit]
Description=MC Service privacy-friendly website analytics
After=network.target

[Service]
Type=simple
User=mcservice-analytics
Group=mcservice-analytics
UMask=0027
WorkingDirectory=/opt/mcservice-analytics
ExecStart=/usr/bin/python3 /opt/mcservice-analytics/server.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/mcservice-analytics
CapabilityBoundingSet=
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
